# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real keys.

# Passcode required to open the app. Leave empty locally to turn the gate off.
APP_PASSCODE=

# Phase 2+: speech-to-text with word timestamps (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Phase 3+: questions and feedback (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model used for analysis
CLAUDE_MODEL=claude-sonnet-5-5
