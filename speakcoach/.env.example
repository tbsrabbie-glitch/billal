# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real keys.

# Passcode required to open the app. Leave empty locally to turn the gate off.
APP_PASSCODE=

# Speech-to-text with word timestamps (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Questions and feedback (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Claude model (default claude-sonnet-5-5; claude-opus-5-5 = deeper, slower, ~2x cost)
CLAUDE_MODEL=
# Optional: thinking effort low | medium | high (default low, for speed)
CLAUDE_EFFORT=

# Demo mode: set to 1 to use built-in sample transcripts/feedback instead of calling the APIs.
MOCK_AI=
